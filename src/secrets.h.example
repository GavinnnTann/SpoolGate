#pragma once

// Copy this file to secrets.h (gitignored) and fill in real values.
//
// IMPORTANT: these are *factory defaults*, not live settings. config::begin()
// seeds NVS from them on the first boot of a blank device and never again, so
// editing this file and reflashing changes nothing on a device that has already
// run. To actually apply a change here:
//
//     pio run -e esp32dev-debug -t erase
//     pio run -e esp32dev-debug -t upload -t monitor
//
// Or skip the erase and set the values in the web portal, which writes NVS
// directly — the easier path for WPA2-Enterprise credentials.

// Set to 1 for WPA2-Enterprise / 802.1X (campus and office networks), 0 for
// plain WPA2-Personal (home). Both code paths are always compiled in; this only
// picks the default. See src/net/uplink.cpp.
#define UPLINK_AUTH_ENTERPRISE 0

// --- Upstream network (STA) ---
//
// Must match the broadcast SSID byte for byte — it is case-sensitive, and a
// hyphen where the network uses an underscore fails with NO_AP_FOUND and no
// other symptom. Copy it from the network details panel rather than typing it.
//
// The ESP32-S3 radio is 2.4 GHz only. A dual-band SSID that happens to be
// 5 GHz-only in the room you are testing in is invisible to it while every
// laptop nearby stays connected. The NAT_DEBUG build scans and lists every AP
// it can see, which tells that case apart from a wrong SSID string.
#define UPLINK_SSID "your-upstream-ssid"

// Used when UPLINK_AUTH_ENTERPRISE == 0. Ignored entirely in enterprise mode.
#define UPLINK_PASS "your-upstream-password"

// Used when UPLINK_AUTH_ENTERPRISE == 1.
//
// Verified against SUTD_Wifi (WPA2-Enterprise, PEAP-MSCHAPv2), which is what
// esp_eap_client does by default once identity, username and password are set —
// no extra phase-2 configuration needed. A network that requires EAP-TTLS/PAP
// instead would need esp_eap_client_set_ttls_phase2_method() adding to
// uplink::begin().
//
// Identity is the outer EAP identity, sent in the clear before the TLS tunnel
// establishes — normally the same as username, unless the network expects an
// anonymous outer identity. Some sites want a bare ID, others a full
// user@domain. Check with IT if a known-good username and password still fail.
//
// No CA certificate is configured, so the RADIUS server certificate is not
// validated. That is what lets this connect without shipping a campus cert; it
// also means the uplink would accept a rogue AP impersonating the network.
#define UPLINK_EAP_IDENTITY "your-student-id"
#define UPLINK_EAP_USERNAME "your-student-id"
#define UPLINK_EAP_PASSWORD "your-network-password"

// --- SoftAP the printer joins ---
//
// PRINTERNET_PASS must be at least 8 characters (WPA2 minimum) — the web portal
// rejects anything shorter. It also seeds the portal's admin password.
#define PRINTERNET_SSID "PrinterNet"
#define PRINTERNET_PASS "change-me-min-8-chars"
